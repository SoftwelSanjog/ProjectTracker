@page "/counter"

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>
<input type="number" class="form-control" @bind="step" />
<button class="btn btn-primary" @onclick="IncrementCount">Add @step</button>

@code {
    private int currentCount = 0;
    private int step = 1;
    private void IncrementCount() => currentCount += step;
}
